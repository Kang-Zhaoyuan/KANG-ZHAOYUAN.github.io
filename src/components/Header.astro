---
import ThemeToggle from '@/components/ThemeToggle.astro';
import {SITE,NAV_LINKS} from '@/site.config';
const currentPath=Astro.url.pathname;
---
<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur"><div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-6 py-4"><a href="/" class="font-display text-ink text-lg font-medium">{SITE.name}</a><nav class="flex items-center gap-3 sm:gap-5" aria-label="Primary">{NAV_LINKS.map(link=><a href={link.href} aria-current={currentPath===link.href || currentPath.startsWith(link.href+'/') ? 'page':undefined} class="text-ink-soft hover:text-signal font-mono text-xs uppercase">{link.label}</a>)}<button type="button" data-language-toggle aria-label="Toggle English and Chinese" class="text-ink-soft hover:text-signal border-line rounded-full border px-2 py-1 font-mono text-xs">中文</button><ThemeToggle/></nav></div></header>
<script is:inline>
(function(){function change(lang){document.documentElement.lang=lang;document.querySelectorAll('[data-zh]').forEach(function(n){if(!n.dataset.en)n.dataset.en=n.textContent; n.textContent=lang==='zh'?n.dataset.zh:n.dataset.en});document.querySelectorAll('[data-language-toggle]').forEach(function(b){b.textContent=lang==='zh'?'EN':'中文'});try{localStorage.setItem('language',lang)}catch(e){}}function bind(){document.querySelectorAll('[data-language-toggle]').forEach(function(b){if(b.dataset.bound)return;b.dataset.bound='1';b.addEventListener('click',function(){change(document.documentElement.lang==='zh'?'en':'zh')})});let lang='en';try{lang=localStorage.getItem('language')||'en'}catch(e){}change(lang)}document.addEventListener('DOMContentLoaded',bind);document.addEventListener('astro:page-load',bind)})();
</script>
