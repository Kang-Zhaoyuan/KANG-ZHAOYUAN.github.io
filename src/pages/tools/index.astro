---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
const items=[
 {title:'Granny Translator',zh:'是你奶奶！',en:'A playful four-symbol text encoder and decoder.',cn:'用四种中文符号进行文本编码与解码的趣味工具。',image:'/media/granny.gif',alt:'Original Granny Translator animation',href:'/translator/',cta:'Open tool →',ctaZh:'打开工具 →'},
 {title:'NetEase Album Exporter',zh:'网易云专辑导出工具',en:'Export saved NetEase Cloud Music albums to CSV.',cn:'将网易云音乐收藏专辑导出为 CSV 数据。',image:'/media/netease-cloud-music.svg',alt:'NetEase Cloud Music logo',href:'https://github.com/Kang-Zhaoyuan/NetEase_Album_Wall',cta:'View source ↗',ctaZh:'查看源码 ↗'},
 {title:'Spherical Harmonic Particle Generator',zh:'球谐函数粒子生成器',en:'Generate irregular 3D particles for geometry and packing studies.',cn:'利用球谐函数生成不规则三维颗粒模型。',image:'/media/spherical-particle.png',alt:'Irregular particle mesh generated from spherical harmonics',href:'https://github.com/Kang-Zhaoyuan/SHPSG-ParticleGenerator',cta:'View source ↗',ctaZh:'查看源码 ↗'}
];
---
<BaseLayout title="Tools">
 <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
  <SectionHeading eyebrow="Tools & experiments" count={items.length}/>
  <div>{items.map((item,index)=><article class="border-line grid grid-cols-[7rem_1fr] gap-5 border-b py-6 sm:grid-cols-[10rem_1fr]">
    <a href={item.href} class="bg-surface flex aspect-[4/3] items-center justify-center overflow-hidden rounded-lg">
      <img src={item.image} alt={item.alt} loading={index===0?'eager':'lazy'} class:list={['h-full w-full',item.image.endsWith('.svg')?'object-contain p-4':'object-contain']} />
    </a>
    <div class="min-w-0 self-center">
     <h2 class="font-display text-ink text-lg sm:text-xl" data-zh={item.zh}>{item.title}</h2>
     <p class="text-ink-soft mt-2 text-sm" data-zh={item.cn}>{item.en}</p>
     <a class="text-signal mt-3 inline-block font-mono text-xs" href={item.href}><span data-zh={item.ctaZh}>{item.cta}</span></a>
    </div>
  </article>)}</div>
 </section>
</BaseLayout>
