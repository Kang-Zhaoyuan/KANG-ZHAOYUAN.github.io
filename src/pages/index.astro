---
import {getCollection} from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import {SITE} from '@/site.config';
const all=await getCollection('work', ({data})=>!data.draft);
const ids=['flipo-flip','cumcm-2026','xv6-oslabs'];
const selected=ids.map(id=>all.find(entry=>entry.id===id)).filter((x):x is typeof all[number]=>!!x);
---
<BaseLayout title={SITE.name}>
 <section class="mx-auto max-w-3xl px-6 pt-16 pb-16 sm:pt-24">
  <p class="text-ink-soft mb-6 font-mono text-xs" data-zh="哈尔滨工业大学（深圳）">{SITE.status}</p>
  <h1 class="font-display text-ink max-w-2xl text-4xl leading-[1.1] font-medium sm:text-5xl" data-zh="过人的智慧是人类最大的财富">{SITE.tagline}</h1>
  <p class="text-ink-soft mt-4 w-full max-w-2xl text-right font-mono text-xs" data-zh="—— 罗伊纳·拉文克劳">— Rowena Ravenclaw</p>
  <p class="text-ink-soft mt-6 max-w-xl" data-zh="哈尔滨工业大学（深圳）本科生，关注数值建模、物理仿真与计算机系统。这里展示我的工程与研究项目。">{SITE.description}</p>
  <div class="mt-8 flex flex-wrap gap-3">
   <Button href="/work"><span data-zh="查看项目 →">View the work →</span></Button>
   <Button href="mailto:KangZhaoyuan0723@gmail.com" variant="ghost"><span data-zh="联系邮箱 ↗">Email ↗</span></Button>
  </div>
 </section>
 <section class="mx-auto max-w-3xl px-6 pb-20">
  <SectionHeading eyebrow="Selected work" count={selected.length}/>
  {selected.map(entry=><WorkRow entry={entry}/>)}
 </section>
 <section class="mx-auto max-w-3xl px-6 pb-20">
  <SectionHeading eyebrow="Tools & experiments" />
  <a class="text-signal font-mono text-sm" href="/tools"><span data-zh="浏览工具 →">Explore tools →</span></a>
 </section>
 <section id="contact" class="mx-auto max-w-3xl px-6 pb-24"><SectionHeading eyebrow="Contact"/><a href="mailto:KangZhaoyuan0723@gmail.com" class="text-signal font-mono text-sm">KangZhaoyuan0723@gmail.com</a><p class="text-ink-soft mt-3 text-sm"><span data-zh="微信公众号">WeChat Official Account</span> · 过的慧人最的富</p></section>
</BaseLayout>
