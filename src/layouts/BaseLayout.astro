---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/site.config';
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
interface Props {title:string;description?:string;image?:string}
const {title,description=SITE.description,image='/media/flipo-poster.png'}=Astro.props;
---
<!doctype html>
<html lang="en">
 <head>
  <script is:inline>try{document.documentElement.lang=localStorage.getItem('language')==='zh'?'zh':'en'}catch(e){document.documentElement.lang='en'}</script>
  <BaseHead title={title} description={description} image={image}/>
 </head>
 <body id="top" class="bg-paper text-ink">
  <Header/>
  <main><slot/></main>
  <Footer/>
 </body>
</html>
